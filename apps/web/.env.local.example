# Copy to .env.local and fill in after deploying the guardian.
NEXT_PUBLIC_GUARDIAN_ADDRESS=
# One of: studioDevnet | studionet | testnetAsimov | testnetBradbury | localnet
# For the Consensus v0.6 / Studio v0.123 release-candidate stack use studioDevnet
# (chain 61997, https://studio-dev.genlayer.com/api). Keep studionet for stable
# Studio: chain identity and consensus contract addresses must move together.
NEXT_PUBLIC_GENLAYER_CHAIN=studioDevnet
# Studio Devnet is a preview deployment the stable Studio explorer does not index,
# so its explorer is configured explicitly rather than read off the chain object.
NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio-dev.genlayer.com
# The registered reference target vault (written to deployments/studio-dev.json by
# the deploy step). The dashboard reads it and runs drills against it.
NEXT_PUBLIC_TARGET_VAULT_ADDRESS=
# Source repository linked from the footer.
NEXT_PUBLIC_REPO_URL=https://github.com/moltaphet/Stasis
